# Public site URL (used for canonical links / sharing)
VITE_SITE_URL=https://www.westventures.ca

# Endpoint the contact form posts to (replace with your real form handler)
VITE_CONTACT_ENDPOINT=https://api.westventures.ca/contact

# Contact details shown across the site
VITE_CONTACT_EMAIL=sales@westventures.ca
VITE_CONTACT_PHONE=+1 (647) 947-4827

# WhatsApp number for the chat widget's quick action (digits only, country code first)
VITE_WHATSAPP_NUMBER=16479474827

# Optional: point this at your own AI backend to power real chatbot replies.
# It should accept POST { message, history } and return JSON { reply }.
# If left blank, the chat widget falls back to its built-in FAQ answers.
VITE_CHAT_ENDPOINT=